# Copy to ~/.config/craft.bml (or split into ~/.config/craft/*.bml) and set
# credentials in your environment. Provider block labels are your aliases,
# not fixed provider names.

# New-session thinking default. Omitted means off; /thinking opens a picker.
# Also accepts true/false, any effort level, or a positive token budget.
# always_thinking = "low"

agent {
  # Extra instructions appended to the assembled system prompt's instructions
  # slot. Empty keeps the built-in defaults.
  preamble = ""
  # System prompt rendering for the session: "markdown" (default) or "xml".
  # prompt_format = "xml"
  # Optional generation settings; omitted by default for provider/model defaults.
  # temperature = 0.2
  # max_tokens = 8192
}

# Compaction stages, ascending by context fill ratio. Omitted entirely, this
# defaults to vcc at 0.6 then llm at 0.8. "vcc" is a deterministic no-LLM
# summary; "llm" runs a one-shot summarization call. A stage whose last run
# saved under 10% of the context is skipped until another stage compacts
# effectively.
compaction "vcc" {
  context = "0.6"
}

compaction "llm" {
  context = "0.8"
}

provider "openai" {
  kind = "openai"
  # Responses API by default; protocol = "chat_completions" switches.
  api_key_env = "OPENAI_API_KEY"

  model "gpt-5.2" {
    name = "GPT-5.2"
    # These are catalog metadata overrides, not generation request parameters.
    context_length = 400000
    max_output_tokens = 32768
  }
}

provider "anthropic" {
  kind = "anthropic"
  api_key_env = "ANTHROPIC_API_KEY"
}

# Any OpenAI-dialect endpoint. A keyless local endpoint (loopback/private
# host, no key) rides the keyless llama.cpp client automatically.
provider "local" {
  kind = "openai-compatible"
  base_url = "http://localhost:8080/v1"
  # No api_key_env: a keyless loopback endpoint rides the keyless
  # llama.cpp client. Set api_key_env only for servers that require a key.
  discover_models = false

  model "my-coding-model" {
    context_length = 32768
  }
}

# Local llama.cpp server (also serves System One decisions on /systemone).
#provider "llamacpp" {
#  kind = "llama-cpp"
#  base_url = "http://localhost:9931/v1"
#}

# Local oMLX server (thinking knobs map to enable_thinking/thinking_budget).
#provider "omlx" {
#  kind = "omlx"
#  base_url = "http://localhost:8000/v1"
#  api_key_env = "OMLX_API_KEY"
#}

# Local Ollama needs no credential unless your server requires one.
provider "ollama" {
  kind = "ollama"
}

