import asyncio
from typing import Any, TypedDict

class Match(TypedDict):
    path: str
    line: int
    text: str

class BashResult(TypedDict):
    exit_code: int
    stdout: str
    stderr: str

ToolError = RuntimeError

async def read_text(path: str) -> str: ...
async def read(path: str, offset: int = 1, limit: int = 200) -> str: ...
async def glob(pattern: str, path: str | None = None) -> list[str]: ...
async def grep(pattern: str, path: str | None = None, case_sensitive: bool = True, max_matches: int = 100) -> list[Match]: ...
async def list_dir(path: str = ".") -> list[str]: ...
async def bash(command: str, description: str | None = None, timeout: int | None = None) -> BashResult: ...
async def edit(path: str, old_string: str, new_string: str) -> str: ...
async def gather(*aws: Any, fail_fast: bool = False) -> list[Any]: ...
